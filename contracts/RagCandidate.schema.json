{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyagerai.dev/phase1/RagCandidate.schema.json",
  "title": "RagCandidate",
  "description": "RAG-FIRST SYSTEM B CHECKPOINT R.1 (additive, non-breaking): the internal, schema-validated shape a Qdrant-retrieved document/entity group must satisfy before System B's itinerary optimizer (architecture.md §6.3) may treat it as a schedulable candidate. Never part of the LocalItinerary A2A artifact itself -- see LocalItinerary.schema.json's additive `candidate_provenance` for what is reported externally. A candidate failing this schema is discarded, never coerced or repaired; raw LLM-generated prose never becomes a candidate without passing every field below.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "entity_id": { "type": "string", "pattern": "^poi_[a-z0-9_]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "district_id": { "type": "string", "pattern": "^district_[a-z0-9_]+$" },
    "side": { "type": "string", "enum": ["european", "asian"] },
    "coordinates": {
      "type": "object",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["lat", "lon"],
      "additionalProperties": false
    },
    "duration_minutes": { "type": "number", "exclusiveMinimum": 0 },
    "preferred_period": {
      "type": "string",
      "enum": ["any", "morning", "afternoon", "evening", "night"]
    },
    "source_url": { "type": "string", "format": "uri" },
    "retrieval_provenance": {
      "type": "object",
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "chunk_id": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 1 },
        "facet": { "type": "string", "minLength": 1 },
        "score": { "type": "number" }
      },
      "required": ["source_id", "chunk_id", "query", "facet", "score"],
      "additionalProperties": false
    },
    "candidate_origin": { "type": "string", "enum": ["rag", "catalog_fallback"] }
  },
  "required": [
    "schema_version", "entity_id", "display_name", "categories", "district_id",
    "side", "coordinates", "duration_minutes", "preferred_period", "source_url",
    "candidate_origin"
  ],
  "additionalProperties": false,
  "if": {
    "properties": { "candidate_origin": { "const": "rag" } }
  },
  "then": {
    "required": ["retrieval_provenance"]
  }
}
