{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyagerai.dev/phase1/ProviderResponseEnvelope.schema.json",
  "title": "ProviderResponseEnvelope",
  "description": "Required response envelope for MCP tool / provider-adapter responses (architecture.md §8.2). Scope: provider/MCP tool responses only — A2A payloads carry their own separately-specified fields (§7.1–7.3), never this envelope.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "provider": { "type": "string", "minLength": 1 },
    "data_mode": {
      "type": "string",
      "enum": ["live", "cached", "historical", "fixture", "estimated"]
    },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "valid_for": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
    },
    "currency": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{3}$"
    },
    "source_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "quality": { "$ref": "DataQuality.schema.json" },
    "result": { "type": "object" }
  },
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "data_mode",
    "retrieved_at",
    "source_urls",
    "quality",
    "result"
  ],
  "additionalProperties": false
}
