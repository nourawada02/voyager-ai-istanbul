{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyagerai.dev/phase1/SourceReference.schema.json",
  "title": "SourceReference",
  "description": "A citation for a grounded claim, mapping generated text back to a specific retrieved chunk or document.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "chunk_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["schema_version", "source_id", "retrieved_at"],
  "additionalProperties": false
}
