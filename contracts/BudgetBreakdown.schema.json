{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyagerai.dev/phase1/BudgetBreakdown.schema.json",
  "title": "BudgetBreakdown",
  "description": "Deterministic budget breakdown. Money is integer minor units, never binary floats; known, estimated, and contingency costs are kept separate (architecture.md §12).",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "known_costs_minor_units": { "type": "integer", "minimum": 0 },
    "estimated_costs_minor_units": { "type": "integer", "minimum": 0 },
    "contingency_minor_units": { "type": "integer", "minimum": 0 },
    "total_minor_units": { "type": "integer", "minimum": 0 },
    "fx_snapshot": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "rate": { "type": "number", "exclusiveMinimum": 0 },
        "timestamp": { "type": "string", "format": "date-time" },
        "inverse_rate_method": { "type": "string", "minLength": 1 }
      },
      "required": ["provider", "rate", "timestamp", "inverse_rate_method"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "currency", "known_costs_minor_units", "estimated_costs_minor_units", "contingency_minor_units", "total_minor_units"],
  "additionalProperties": false
}
