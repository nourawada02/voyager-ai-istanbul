{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyagerai.dev/phase3/Chunk.schema.json",
  "title": "Chunk",
  "description": "One deterministic, heading-aware token chunk produced by RAG ingestion (architecture.md §9). Indexed in Qdrant with the same id. Never contains current-price/availability/opening-hours content -- see rag/corpus source-boundary rules. 'ingestion_version' (Manual QA remediation Q.1, §A) is optional and additive -- the ingestion config fingerprint this point was written under (rag/ids.py::config_fingerprint), the same value as the collection's own fingerprint marker point, recorded per-chunk too. Every chunk written before this addition remains valid unchanged (the field is simply absent).",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "chunk_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["en", "tr", "ar"] },
    "content_type": { "type": "string", "minLength": 1 },
    "heading_path": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "text": { "type": "string", "minLength": 1 },
    "token_count": { "type": "integer", "minimum": 1 },
    "char_start": { "type": "integer", "minimum": 0 },
    "char_end": { "type": "integer", "minimum": 0 },
    "chunk_index": { "type": "integer", "minimum": 0 },
    "poi_id": { "type": "string", "pattern": "^poi_[a-z0-9_]+$" },
    "district_id": { "type": "string", "pattern": "^district_[a-z0-9_]+$" },
    "source_checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chunk_config": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "ingestion_version": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "interest_tags": {
      "description": "RAG-FIRST SYSTEM B CHECKPOINT R.1 (additive, optional): supported-interest tags from the source document (rag/corpus_sources.py). Every chunk written before this checkpoint remains valid with this field absent.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "side": { "type": "string", "enum": ["european", "asian"] },
    "display_name": { "type": "string", "minLength": 1 },
    "preferred_period": {
      "type": "string",
      "enum": ["any", "morning", "afternoon", "evening", "night"]
    },
    "entity_kind": { "type": "string", "enum": ["poi_candidate", "general_knowledge"] }
  },
  "required": [
    "schema_version", "chunk_id", "source_id", "language", "content_type",
    "heading_path", "text", "token_count", "char_start", "char_end",
    "chunk_index", "source_checksum", "chunk_config"
  ],
  "additionalProperties": false
}
