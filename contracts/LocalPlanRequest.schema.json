{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyagerai.dev/phase1/LocalPlanRequest.schema.json",
  "title": "LocalPlanRequest",
  "description": "System A -> System B A2A request payload (architecture.md §7.1).",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "contract_version": { "const": "1.0.0" },
    "trip_start_date": { "type": "string", "format": "date" },
    "trip_end_date": { "type": "string", "format": "date" },
    "available_local_time_minutes": { "type": "integer", "minimum": 0 },
    "interests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "pace": { "type": "string", "enum": ["relaxed", "moderate", "packed"] },
    "language": { "type": "string", "enum": ["en", "tr", "ar"] },
    "mobility_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "daily_activity_budget_minutes": { "type": "integer", "minimum": 0 },
    "stay_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 }
        },
        "required": ["candidate_id", "lat", "lon"],
        "additionalProperties": false
      }
    },
    "weather_context": { "type": "object" },
    "hard_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "soft_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "schema_version", "session_id", "trace_id", "contract_version",
    "trip_start_date", "trip_end_date", "interests", "pace", "language",
    "mobility_constraints", "daily_activity_budget_minutes", "stay_candidates",
    "hard_constraints", "soft_constraints"
  ],
  "additionalProperties": false
}
