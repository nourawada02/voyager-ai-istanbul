{
  "schema_version": "1.0.0",
  "checkpoint": "Final Evaluation Checkpoint E.1",
  "description": "Predeclared, frozen live-Qwen decision-routing case manifest. Case IDs, languages, input states, and expected_actions are fixed at generation time and never edited after seeing a live-model result.",
