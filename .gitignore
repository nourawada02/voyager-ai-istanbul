.env
__pycache__/
*.pyc
.venv/
node_modules/
*.egg-info/

# Phase 4 Checkpoint D.2A: the production System A service's runtime
# SQLite database (run/session/event persistence + the LangGraph
# checkpoint tables) -- generated at run time from an explicit
# configurable path (VOYAGER_SYSTEM_A_DB_PATH), never committed, and
# never used by any test (tests always point at a pytest tmp_path).
# Scoped narrowly to this one directory -- never a repository-global
# *.db/*.db-wal/*.db-shm pattern, which would silently hide an unrelated
# SQLite file anywhere else in the tree.
orchestration/data/*
!orchestration/data/.gitkeep

# Phase 2: downloaded/generated accommodation datasets (see
# docs/adr/0002-phase2-checkpoint-a.md). The canonical dataset manifest
# (data/manifests/*.manifest.json) is small aggregate metadata and stays
# tracked; the raw/processed bulk data is ignored. *.profile.json files in
# the same directory are a separately generated profiling report (produced
# by phase2/data_pipeline/profile_dataset.py, not hand-authored) and are
# ignored too -- narrowly scoped to that one suffix, not all JSON/manifest
# files in the directory.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/manifests/*.profile.json

# Phase 2: generated model artifacts (trained model, preprocessing pipeline,
# bundled feature schema) and generated metrics reports -- reproducible from
# data/ + ml/training/, never committed (Checkpoint A.2: reports containing
# generated metrics are artifacts too, not audit-trail documents).
ml/artifacts/*
!ml/artifacts/.gitkeep
ml/reports/*
!ml/reports/.gitkeep

# Phase 3: local Qdrant on-disk storage (if a persisted path is ever used
# instead of embedded in-memory mode), embedding-model download caches,
# and any downloaded model weights -- never committed. The pinned E5
# revision/model name is recorded as text (rag/embeddings.py), never the
# weights themselves; corpus manifests/documents/ground-truth JSON stay
# tracked as small evaluation/reproducibility artifacts.
rag/qdrant_storage/
rag/.model_cache/
*.safetensors
*.onnx

# Phase 3: resumability checkpoint for the live 45-case generation eval
# run (rag/run_generation_eval.py) -- a scratch JSONL of already-computed
# per-question rows so an interrupted long-running Ollama-backed run can
# resume without redoing completed questions. Not evaluation output; the
# committed artifact is the final rag_generation_eval_report_remediated.json.
rag/_gen_eval_checkpoint.jsonl
