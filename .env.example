# Phase 3 RAG generation evaluation -- provider configuration.
# Placeholders only; copy to .env and fill in real values there.
# Never commit a real .env file.

# Judge provider (Groq, OpenAI-compatible Chat Completions).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_GENERATOR_MODEL=qwen/qwen3.6-27b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# Generator provider (QwenCloud / Alibaba Model Studio, OpenAI-compatible
# Chat Completions). QWEN_BASE_URL has no default and must be set
# explicitly to your workspace's HTTPS endpoint.
QWEN_API_KEY=
# Official-name compatibility fallback for QWEN_API_KEY, if you already
# have DASHSCOPE_API_KEY set for other tooling.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_GENERATOR_MODEL=qwen3.7-flash

# Local development fallback only -- never silently used in place of a
# required hosted provider during an acceptance run.
OLLAMA_HOST=http://localhost:11434

# Role-specific provider selection for rag.run_generation_eval /
# rag.run_smoke_eval. Values are provider names: groq | qwen | ollama.
GEN_EVAL_GENERATOR_PROVIDER=
GEN_EVAL_JUDGE_PROVIDER=

# Fail-closed acceptance gates: if set, the run fails before any
# ingestion/retrieval/provider call unless the resolved provider for
# that scope matches exactly.
GEN_EVAL_REQUIRE_PROVIDER=
GEN_EVAL_REQUIRE_GENERATOR_PROVIDER=
GEN_EVAL_REQUIRE_JUDGE_PROVIDER=

# Phase 4 Checkpoint D.2A -- the public System A service
# (orchestration/system_a/api.py). None of these are secrets; every one
# has a safe built-in default (orchestration/system_a/config.py) and the
# service starts without any of them being set.
VOYAGER_SYSTEM_A_DB_PATH=
VOYAGER_SYSTEM_A_MAX_WORKERS=
VOYAGER_SYSTEM_A_SQLITE_BUSY_TIMEOUT_MS=
VOYAGER_SYSTEM_A_SSE_POLL_SECONDS=
VOYAGER_SYSTEM_A_SSE_HEARTBEAT_SECONDS=

# Phase 4 Checkpoint D.2B -- explicit deterministic demo/fixture mode
# (orchestration/system_a/config.py::system_a_mode). Not a secret. Two
# different defaults apply depending on how System A is run -- neither
# ever silently falls back to the other:
#   - Standalone (e.g. `python -m orchestration.system_a.entrypoint`,
#     or any hermetic test): unset means "real" (real Qwen +
#     ProductionToolExecutor) -- the same behavior every prior
#     checkpoint already had.
#   - Under root docker-compose.yml: unset resolves to "fixture"
#     explicitly (Compose's own `${VOYAGER_SYSTEM_A_MODE:-fixture}`
#     substitution supplies that default into the container's
#     environment) -- `docker compose up` with no `.env` file at all
#     makes zero paid-provider calls out of the box.
# Real-provider mode under Compose requires setting this to exactly
# "real" here AND supplying QWEN_API_KEY/QWEN_BASE_URL/SERPAPI_API_KEY
# below. Any value other than "real"/"fixture" is a hard startup error,
# never a guess.
VOYAGER_SYSTEM_A_MODE=

# Phase 4 Checkpoint D.2B -- production composition targets for
# orchestration/system_a's real MCP/A2A clients when running outside
# root docker-compose.yml (which already sets these to internal Compose
# service names -- these placeholders matter only for standalone/local
# runs). Not secrets, but real internal endpoints, never localhost
# inside a container.
TRAVEL_MCP_BASE_URL=
ISTANBUL_EXPERT_A2A_BASE_URL=

# Phase 4 Checkpoint C.2/C.3 -- SerpApi (web evidence + Google Flights).
# A real secret; never committed, never logged (providers/redaction.py).
SERPAPI_API_KEY=

# Manual QA remediation Q.1 (second correction pass, §2) -- System B's
# real Qdrant RAG query path (services/istanbul-expert-b). Left BLANK
# here deliberately: root docker-compose.yml's own
# QDRANT_URL: "${QDRANT_URL:-http://vector-db:6333}" already supplies a
# real, non-secret, committed default (the internal Compose service
# name) whenever this line is unset or commented out -- a fresh
# clone/empty .env resolves System B to the real vector-db service by
# construction, with no manual edit required. Populate vector-db first
# via `docker compose run --rm rag-ingest bootstrap` (see
# docker-compose.yml's own rag-ingest comment) so System B has real data
# to serve once it connects. Uncomment and set explicitly here only to
# OVERRIDE the default (e.g. point at an external Qdrant instance, or
# set to a literal empty value to force-skip System B's real embedding-
# model warmup for a genuinely offline fixture run -- a real,
# internet-dependent, multi-minute cold start on an unprimed cache,
# observed directly in this checkpoint's own gate). Not a secret; a
# Qdrant instance URL.
# QDRANT_URL=http://vector-db:6333

# Phase 4 Checkpoint D.2B -- the frontend's only network boundary
# (services/frontend/phase6/api_client.py). Root docker-compose.yml sets
# this to the internal Compose service name automatically; only needed
# here for running the Streamlit app standalone outside Compose. Not a
# secret; never `localhost` when the frontend itself runs in a container.
AGENT_SYSTEM_A_BASE_URL=
